# AI-IAM Platform — environment configuration.
#
# Copy this file to `.env` in the same directory (backend/) and fill in
# real values. `.env` is gitignored — never commit it.
#
# The app is run with `backend/` as the working directory (see
# docker/Dockerfile's WORKDIR and the README's `cd backend && uvicorn ...`),
# so every relative path below (keys/, alembic/) resolves from there.

# ── App ──────────────────────────────────────────────────────────────────
APP_NAME="AI-IAM Platform"
APP_VERSION="1.0.0"
DEBUG=True
ENVIRONMENT="development"

# ── PostgreSQL ───────────────────────────────────────────────────────────
# No default in code on purpose — a missing DATABASE_URL must fail startup
# loudly rather than silently fall back to something unexpected.
DATABASE_URL="postgresql+asyncpg://aiiam_user:supersecretpassword@localhost:5432/aiiam_db"
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ── JWT (RS256, agent tokens) ────────────────────────────────────────────
# JWT_SECRET_KEY signs HS256 *operator* tokens only (app/api/deps.py).
# Agent tokens are RS256, signed/verified via the key pair below — generate
# with `scripts/generate_keys.sh` before first run.
JWT_SECRET_KEY="replace-with-a-random-64-byte-value-never-commit-this"
JWT_ALGORITHM="RS256"
JWT_PRIVATE_KEY_PATH="keys/private.pem"
JWT_PUBLIC_KEY_PATH="keys/public.pem"

# ── Agent credential TTLs ────────────────────────────────────────────────
AGENT_ACCESS_TOKEN_EXPIRE_MINUTES=15
AGENT_REFRESH_TOKEN_EXPIRE_HOURS=2
API_KEY_DEFAULT_TTL_DAYS=30

# ── SPIFFE — workload identity ───────────────────────────────────────────
SPIFFE_TRUST_DOMAIN="ai-iam.internal"
# Leave unset (or "None") for local/dev mock mode — see app/core/spiffe.py
SPIRE_AGENT_SOCKET=

# ── OPA — policy engine ──────────────────────────────────────────────────
# Bare origin only — app/core/permissions.py appends OPA_POLICY_PATH itself.
OPA_URL="http://localhost:8181"
OPA_POLICY_PATH="v1/data/aiiam/authz"

# ── Security hardening ────────────────────────────────────────────────────
BCRYPT_ROUNDS=12
MAX_DELEGATION_DEPTH=5
API_KEY_PREFIX="aiiam_"

# ── Audit ─────────────────────────────────────────────────────────────────
AUDIT_HASH_ALGORITHM="sha256"
